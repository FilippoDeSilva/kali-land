# Environment variables for Kali Omarchy Desktop Installation
# Copy this file to .env and fill in your credentials if needed
# DO NOT commit the actual .env file to version control

# GitHub Credentials (Optional)
# Only needed if you need to clone private repositories
# For public repositories (like Hyprland and Quickshell), these are not required
# Leave empty to use public cloning (recommended for most users)

GITHUB_USERNAME=
GITHUB_TOKEN=

# Installation Options (Optional)
# Set to 'true' to enable non-interactive mode
INSTALL_NON_INTERACTIVE=false

# Set to 'true' to enable dry-run mode
INSTALL_DRY_RUN=false

# Specific phase to run (0-13), leave empty to run all phases
INSTALL_PHASE=

# Build Options (Optional)
# Number of parallel jobs for compilation
BUILD_JOBS=$(nproc)

# Temporary build directory
BUILD_DIR=/tmp/kali-omarchy-build