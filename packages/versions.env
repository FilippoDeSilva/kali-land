# versions.env - Pinned version matrix for external dependencies
# AGENT.md §33-35: All external artifacts must be versioned, architecture-aware, and checksum-verified.
# Do NOT change these to "latest" or "master" — pin explicit versions/SHAs for reproducibility.

# ── Quickshell ─────────────────────────────────────────────────────────────────
# Latest stable: https://github.com/quickshell-mirror/quickshell/releases
QUICKSHELL_VERSION="0.3.1"
QUICKSHELL_REPO="quickshell-mirror/quickshell"
QUICKSHELL_TAG="v0.3.1"
# Source build ref (used when no prebuilt artifact is available)
QUICKSHELL_COMMIT="v0.3.1"

# ── Caelestia Shell ────────────────────────────────────────────────────────────
# Pinned commit SHA from caelestia-dots/shell main (2026-09-07)
# https://github.com/caelestia-dots/shell/commit/4e57199fd54f7e53191cc3481143f43cd9582e41
CAELESTIA_REPO="caelestia-dots/shell"
CAELESTIA_COMMIT="4e57199fd54f7e53191cc3481143f43cd9582e41"
CAELESTIA_COMMIT_DATE="2026-09-07"
# Artifact name pattern for GitHub Release downloads
CAELESTIA_ARTIFACT_NAME="caelestia-plugin-linux"

# ── Matugen ────────────────────────────────────────────────────────────────────
MATUGEN_VERSION="0.16.0"
MATUGEN_REPO="InioX/matugen"

# ── cpptrace (Quickshell build dep) ────────────────────────────────────────────
CPPTRACE_VERSION="v1.0.4"
CPPTRACE_REPO="jeremy-rifkin/cpptrace"

# ── Hyprland ───────────────────────────────────────────────────────────────────
HYPRLAND_VERSION="0.42.0"
HYPRLAND_REPO="hyprwm/Hyprland"
HYPRLAND_TAG="v0.42.0"

# ── Supported architectures ────────────────────────────────────────────────────
# AGENT.md §35: Detect arch explicitly; never assume x86_64.
# aarch64 falls back to local source build (no CI prebuilt artifact).
SUPPORTED_ARCHS=("x86_64" "amd64" "aarch64" "arm64")
PREBUILT_ARCHS=("x86_64")  # Architectures with CI-produced prebuilt artifacts

